# Copy to .env and fill in. Every setting in agent/config.py can also be set here (e.g. MAX_FOLLOW_UPS=4).
# Precedence: defaults < preset < this file and environment variables < command-line flags.

# Named settings: local (the defaults, sized for qwen on a small GPU) or hosted (more
# follow-ups and revisions). Also `run.py --preset hosted`.
PRESET=local

# Provider: ollama (local, default), openrouter or anthropic (hosted). Each keeps its own model,
# so switching is this one line (or `run.py --provider openrouter`).
MODEL_PROVIDER=ollama
# Optional per-role overrides (ANALYST_MODEL, CODER_MODEL, REPORTER_MODEL); empty = the provider's model

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# Model layers on the GPU (empty = Ollama decides). Ollama is conservative on small GPUs;
# fill dedicated VRAM but don't spill into shared memory, which is slower than CPU.
# Leave ~0.5 GB free for long prompts. Example: qwen3.5:9b on a 4 GB GPU with the 16k context -> 17
LLM_NUM_GPU=

# OpenRouter. Prompts and data samples leave the machine. ":free" models are capped per
# day (a reference run is ~60 requests); scripts/llm_smoke.py shows what is left.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REASONING=true

# Anthropic. Prompts and data samples leave the machine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# LangSmith tracing (optional). When enabled, prompts and data samples are sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# EU workspaces use https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=data-analyst-agent
